# Copy to .env and fill in. .env is gitignored — never commit real values.
# All three are required; the app fails at startup rather than falling back
# to a baked-in host or key.
#
# API_KEY/API_SECRET come from an ERPNext User's API Access section
# (User > API Access > Generate Keys). The Authorization header is derived
# from the pair in code — don't store a pre-built token here.
API_URL=https://erpnext.example.com
API_KEY=
API_SECRET=
